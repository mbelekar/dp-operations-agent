ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
AUDIT_LOG_DIR=logs/audit

# Optional: LangSmith tracing (observability/debugging, separate from the
# audit log above, which is the compliance record). Leave unset to disable;
# tracing is a no-op with no code changes needed either way.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dp-ops-agent
