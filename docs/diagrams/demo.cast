[45.899, "o", "{\r\n  \"diagnosis_id\": \"8573be91-9bc5-409f-afa1-87d95fb96996\",\r\n  \"session_id\": \"2128ae20-61fe-40cb-924a-7ffe1bd0f869\",\r\n  \"system\": \"kafka\",\r\n  \"root_cause_hypothesis\": \"The billing-svc lag alert on the `orders` topic is a downstream symptom of broker-1 instability. Broker 1 (leader for partition 7) shows a critical ISR shrink rate with almost no compensating expands, indicating it is intermittently failing to service follower fetch requests in time (consistent with GC pauses, disk/network pressure, or an overloaded broker process). This caused partition 7's ISR to collapse from [1,2,3] down to just [1], leaving it under-replicated while partition 0 remained healthy. Producer throughput to partitions 0 and 7 is essentially even (no hot-partition skew), and the billing-svc consumer group shows a stable membership with zero rebalances, ruling out key skew or a rebalance storm as the cause. With partition 7 under-replicated and its leader broker degraded, consumption/replication on that partition stalled, produci"]
[0.000, "o", "ng the large, isolated lag spike on partition 7 (~12500) versus partition 0 (~200) seen in the consumer_lag_trend data. Root cause: broker 1 flakiness driving ISR churn/under-replication on orders-partition-7, not a consumer-side or producer-key issue.\",\r\n  \"confidence\": \"high\",\r\n  \"evidence_chain\": [\r\n    {\r\n      \"step\": 1,\r\n      \"signal_id\": \"47de08f6-0ff7-4b51-8b67-a5cfb0fd1bf3\",\r\n      \"interpretation\": \"Consumer lag is heavily concentrated on partition 7 (12500) vs partition 0 (200), pointing to a partition-specific problem rather than a general consumer slowdown.\"\r\n    },\r\n    {\r\n      \"step\": 2,\r\n      \"signal_id\": \"b1cd01bb-bd58-404c-af4a-495558dac83b\",\r\n      \"interpretation\": \"Throughput is nearly even across partitions 0 and 7 (skew_ratio ~1.07, severity ok), ruling out hot-partition/key-skew as the cause of the lag.\"\r\n    },\r\n    {\r\n      \"step\": 3,\r\n      \"signal_id\": \"7cf4556c-9b55-4ae5-9fc8-b413d304e400\",\r\n      \"interpretation\": \"Zero rebalances in the window rules out a rebalance storm or c"]
